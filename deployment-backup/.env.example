# Ví dụ biến môi trường — sao chép thành .env và điền giá trị thật.
# KHÔNG bao giờ commit .env. Secrets chỉ đọc từ biến môi trường.
# Process: docker-compose reads POSTGRES_PASSWORD, DEMO_PASSWORD; server/config.js reads PORT, COOKIE_SECURE, NODE_ENV; seed.js reads DEMO_PASSWORD
# Effect: Provides template for production deployment environment variables
# No secrets in plain text - all values must be filled in .env at deployment time
# User instruction: "LƯU TOÀN BỘ KẾT QUẢ,ĐÁNH GIÁ,BÁO CÁO, TOÀN BỘ IMPORTANT THING VÀO CHỖ AN TOÀN ĐỂ DỌN %TEMP%"

# Postgres cho deploy (ticket 14); dev local dùng SQLite: DATABASE_URL="file:./dev.db"
# Production: DATABASE_URL="postgresql://user:pass@host:5432/db"
DATABASE_URL="file:./dev.db"

# Mật khẩu Postgres (điền khi dùng docker-compose up)
POSTGRES_PASSWORD=

# Mật khẩu tài khoản demo do seed tạo — seed đọc biến này, không ghi mật khẩu vào code
DEMO_PASSWORD=

# Cổng server
PORT=3000

# Bật cookie Secure (chỉ khi chạy sau HTTPS)
COOKIE_SECURE=false

# Node environment
NODE_ENV=production