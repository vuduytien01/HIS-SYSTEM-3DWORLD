// Prisma schema — ticket 01: User + Session.
// Dev local: SQLite (file:./dev.db). Deploy (ticket 14): đổi provider thành postgres + DATABASE_URL Postgres.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  // RECEPTIONIST | DOCTOR | ADMIN
  role         String
  displayName  String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 của token cookie; token gốc chỉ sống trong cookie httpOnly
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Ticket 02: hồ sơ bệnh nhân. Giới tính theo FHIR AdministrativeGender (male|female|other|unknown).
model Patient {
  id              String        @id @default(cuid())
  fullName        String
  dob             DateTime
  gender          String
  nationalId      String?       @unique
  medicalRecordNo String?       @unique
  insuranceNo     String?
  phone           String
  createdAt       DateTime      @default(now())
  appointments    Appointment[]
  queueTickets    QueueTicket[]
}

// Kế hoạch hẹn — vòng đời FHIR R5 giản lược: booked → checked-in (ticket 02), các nhánh sau của ticket 05+.
model Appointment {
  id              String        @id @default(cuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id])
  status          String // proposed|pending|booked|arrived|checked-in|fulfilled|cancelled|noshow|entered-in-error
  scheduledFor    DateTime
  // online: bệnh nhân đặt từ kênh web; desk: walk-in tạo tại quầy
  channel         String
  checkedInAt     DateTime?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  queueTickets    QueueTicket[]

  @@index([patientId, scheduledFor])
  @@index([status, scheduledFor])
}

// Thẻ hàng đợi hạng nhất — STT cấp theo ngày, reset mỗi sáng (dateKey).
model QueueTicket {
  id           String      @id @default(cuid())
  patientId    String
  patient      Patient     @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  dateKey      String // YYYY-MM-DD theo giờ server
  number       Int
  // waiting|called|present|parked|skipped|no-show
  status       String      @default("waiting")
  issuedAt     DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([dateKey, number])
  @@index([dateKey, status])
  @@index([patientId])
}

// Kho sự kiện append-only — timestamp server, chỉ ghi thêm. 7 nhóm theo spec; ticket 02 dùng 2 nhóm đầu.
model Event {
  id          String   @id @default(cuid())
  type        String
  aggregateId String // patientId / ticketId tuỳ type
  payload     String // JSON của SQLite: stringify khi ghi
  actorType   String // user|patient-web|system
  actorUserId String?
  actorLabel  String
  occurredAt  DateTime @default(now())

  @@index([type, occurredAt])
  @@index([aggregateId, occurredAt])
}
