# Ví dụ biến môi trường — sao chép thành .env và điền giá trị thật.
# KHÔNG bao giờ commit .env. Secrets chỉ đọc từ biến môi trường.

# Postgres cho deploy (ticket 14); dev local dùng SQLite: DATABASE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# Secret ký session cookie — bắt buộc trong production, dev thiếu sẽ sinh ngẫu nhiên kèm cảnh báo
SESSION_SECRET=

# Mật khẩu tài khoản demo do seed tạo — seed không ghi mật khẩu vào code
DEMO_PASSWORD=

# Cổng server
PORT=3000

# Bật cookie Secure (chỉ khi chạy sau HTTPS)
COOKIE_SECURE=false
